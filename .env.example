# ============================================================
# GOAL-IA CONTENT ENGINE — Variables d'environnement
# Copier ce fichier vers `.env.local`, puis remplir les valeurs.
# NE JAMAIS commiter `.env.local` (voir .gitignore et PRD §33).
# Les secrets vivent uniquement dans .env.local + Vercel.
# ============================================================

# --- Application ---------------------------------------------------
# Niveau de log du logger : debug | info | warn | error
LOG_LEVEL=info

# Secret optionnel pour protéger les endpoints appelés par Vercel Cron
CRON_SECRET=

# --- Supabase (mémoire structurée — PRD §3.4) — PHASE 0/1 ----------
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Clé « service_role » : usage UNIQUEMENT côté serveur (jamais frontend)
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare R2 (stockage fichiers lourds — PRD §3.5) — PHASE 0 --
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optionnel : endpoint R2.
# Défaut calculé si absent : https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=

# --- DeepSeek API (IA principale — PRD §3.6) — PHASE 1 -------------
DEEPSEEK_API_KEY=
# Optionnel : modèle DeepSeek utilisé (défaut : deepseek-v4-flash)
DEEPSEEK_MODEL=

# --- ElevenLabs (voix off — PRD §3.7) — PHASE 3 ---------------------
# Plusieurs clés possibles (multi-comptes gratuits ~10k crédits/mois chacun).
# Le provider essaie chaque clé et bascule automatiquement si quota épuisé
# (HTTP 401/402/429). Formats acceptés (au choix) :
#   Format 1 — une variable par compte (recommandé) :
ELEVENLABS_API_KEY_01=
ELEVENLABS_API_KEY_02=
ELEVENLABS_API_KEY_03=
#   Format 2 — liste séparée par des virgules :
ELEVENLABS_API_KEYS=
#   Format 3 — une seule clé :
ELEVENLABS_API_KEY=
# Voix utilisée par défaut (défaut : première voix du compte)
ELEVENLABS_VOICE_ID=
# Modèle utilisé (défaut : celui choisi par ElevenLabs)
ELEVENLABS_MODEL=

# --- WhatsApp Business Cloud API (contrôle humain — PRD §3.10) — PHASE 8
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# --- TikTok (publication — PRD §3.9) — PHASE 9 ----------------------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_OPEN_ID=

# --- Facebook / Meta Graph API (publication — PRD §3.9) — PHASE 9 ---
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_PAGE_ID=
FACEBOOK_ACCESS_TOKEN=
